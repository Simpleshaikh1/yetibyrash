# Copy to .env for local overrides. Every value below is also the built-in default for development.
APP_ENV=development
HTTP_ADDR=:8090
DATABASE_URL=postgres://yetibyrash:yetibyrash@localhost:5432/yetibyrash?sslmode=disable

# Product photos are saved here (relative to backend/). Ignored by git.
MEDIA_DIR=var/media

# Addresses the admin app is served from. Admin changes sent from anywhere else are refused.
ADMIN_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Development-only owner account, created by `go run ./cmd/seed` when there are no staff yet.
# Sign in to the admin with these. Never use them on a real server.
DEV_OWNER_EMAIL=owner@yetibyrash.test
DEV_OWNER_PASSWORD=yetibyrash-dev-owner

# Added in later milestones:
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# SMTP_ADDR=localhost:1025
